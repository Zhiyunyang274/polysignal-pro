# PolySignal Pro Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# DATA MODE (Phase 4A)
# =============================================================================

# Data source mode: mock | real_readonly | hybrid
# Default: mock (uses simulated data)
# real_readonly: uses real Polymarket API (read-only)
# hybrid: tries real API first, falls back to mock on failure
DATA_MODE=mock

# API settings
API_TIMEOUT_SECONDS=10
API_MAX_RETRIES=3

# =============================================================================
# TRADING MODE (IMPORTANT: Default is READ-ONLY + PAPER TRADING)
# =============================================================================

# Enable live trading (default: false)
LIVE_TRADING_ENABLED=false

# Allow automatic execution without manual confirmation (default: false)
ALLOW_AUTO_EXECUTION=false

# Enable paper trading (default: true)
PAPER_TRADING_ENABLED=true

# =============================================================================
# TELEGRAM (OPTIONAL)
# =============================================================================

# Telegram Bot Token (optional - if not set, alerts go to CLI/logs only)
# TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID (optional)
# TELEGRAM_CHAT_ID=your_chat_id_here

# =============================================================================
# LLM PROVIDERS (Phase 4C)
# =============================================================================

# LLM Provider Selection: mock | deepseek | glm | sensenova | xfyun_anthropic | router
# Default: mock (safe for testing)
LLM_PROVIDER=mock

# DeepSeek API (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# GLM/Z.AI API (optional)
# ZAI_API_KEY takes precedence over GLM_API_KEY
ZAI_API_KEY=
GLM_API_KEY=
ZAI_MODEL=glm-5
GLM_MODEL=glm-5

# SenseNova API (OpenAI-compatible)
SENSENOVA_API_KEY=
SENSENOVA_MODEL=sensenova-6.7-flash-lite

# XFyun Anthropic API
XFYUN_API_KEY=
XFYUN_MODEL=astron-code-latest

# =============================================================================
# DATABASE
# =============================================================================

# SQLite database path (default: data/polysignal.db)
DATABASE_PATH=data/polysignal.db

# =============================================================================
# LOGGING
# =============================================================================

# Log level (default: INFO)
LOG_LEVEL=INFO

# Log file path (default: logs/polysignal.log)
LOG_FILE=logs/polysignal.log

# =============================================================================
# WALLET (NEVER PUT REAL PRIVATE KEYS HERE)
# =============================================================================

# Test wallet address (for wallet intelligence mock only)
# TEST_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
